APP_NAME="Hotel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados (MySQL é o padrão; o docker-compose já sobe um servidor).
# Com "docker compose up", o DB_HOST é definido como "mysql" pelo próprio compose.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_api
DB_USERNAME=hotel_api
DB_PASSWORD=secret

# Alternativa sem MySQL: SQLite (execute `touch database/database.sqlite`).
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=log
