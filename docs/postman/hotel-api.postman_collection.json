            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/hotels",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 9001,\n  \"name\": \"Hotel Teste Postman\"\n}"
            }
          }
        },
        {
          "name": "Atualizar hotel",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
