{
  "info": {
    "name": "Hotel API",
    "description": "Collection da Hotel API: importação de XML, hotéis, quartos, reservas e recomendação de restaurantes (Dijkstra).\n\nVariável: base_url (padrão http://localhost:8000/api).\nFluxo básico: 1) Import > Importar tudo; 2) Rooms > Verificar disponibilidade; 3) Reserves > Criar reserva (201) e depois Criar reserva com conflito (409); 4) Restaurants > Recomendações para o hotel 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "hotel-api-collection"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    }
  ],
  "item": [
    {
      "name": "Import",
      "item": [
        {
          "name": "Importar tudo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/import/all"
          }
        },
        {
          "name": "Importar hotéis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/import/hotels"
          }
        },
        {
          "name": "Importar quartos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/import/rooms"
          }
        },
        {
          "name": "Importar reservas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/import/reserves"
          }
        }
      ]
    },
